# open-stats: GoatCounter, reachable on 127.0.0.1:8081 only.
# Install as /etc/systemd/system/goatcounter.service (see collector/README.md).
[Unit]
Description=GoatCounter for open-stats (localhost only)
Documentation=https://github.com/tkjaer/open-stats/blob/main/collector/README.md
After=network.target

[Service]
Type=simple
User=goatcounter
Group=goatcounter
# -json keeps IP addresses out of its log; -ratelimit lifts its own limit of 4
# counts a second per IP address (see collector/README.md).
ExecStart=/usr/local/bin/goatcounter serve \
    -db sqlite+/var/lib/goatcounter/db.sqlite3 \
    -listen 127.0.0.1:8081 \
    -tls http \
    -automigrate \
    -smtp stdout \
    -json \
    -ratelimit=count:1000/1
Restart=on-failure
RestartSec=5s

# Data: only /var/lib/goatcounter is writable.
StateDirectory=goatcounter
StateDirectoryMode=0700
WorkingDirectory=/var/lib/goatcounter
ReadWritePaths=/var/lib/goatcounter
UMask=0077

# Resources: stay out of the way of nginx and the server's other services.
CPUWeight=20
IOWeight=20
MemoryHigh=120M
MemoryMax=150M
TasksMax=64
LimitNOFILE=4096

# Sandboxing.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
# GoatCounter needs no outbound network: the GeoIP database is built in, and
# there is no ACME and no mail.
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
