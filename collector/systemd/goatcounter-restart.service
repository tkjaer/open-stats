# open-stats: started by goatcounter-restart.timer. Restarts GoatCounter only if
# it is running, so it never starts a stopped or failing one. GoatCounter
# stores the counts it holds before it exits.
# Install as /etc/systemd/system/goatcounter-restart.service.
[Unit]
Description=Restart GoatCounter (clears its rate limiter)
Documentation=https://github.com/tkjaer/open-stats/blob/main/collector/README.md
# Wait for a running export to finish first.
After=open-stats-export.service

[Service]
Type=oneshot
ExecStart=/bin/systemctl try-restart goatcounter.service

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
