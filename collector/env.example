# /etc/open-stats/env: read by open-stats-export.service.
# Written by `open-stats configure`; owned by root, mode 600. Never commit the
# real file.

# API token for GoatCounter's local API: read statistics and site settings
# only, for all open-stats sites.
GOATCOUNTER_TOKEN=<token written by open-stats configure>

# Optional: where GoatCounter listens (default http://127.0.0.1:8081).
#GOATCOUNTER_URL=http://127.0.0.1:8081
